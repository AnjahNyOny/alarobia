# Variables du site. En local : copier ce fichier en .env et renseigner AUTH_SECRET.
# Sur Netlify (configuration du site, variables d'environnement), une valeur par contexte (PLAN.md 7.6) :
# - « Production » (branche main) : base Neon de production, secrets de production, adresse du site ;
# - « Branch deploys » et « Deploy Previews » (branche preview, adresse https://preview--alarobia-shop.netlify.app) :
#   branche Neon `preview`, AUTH_SECRET et CRON_SECRET propres, NEXT_PUBLIC_SITE_URL vide. Aucun aperçu ne doit toucher
#   la base réelle : sa compilation y appliquerait ses migrations.
# Une variable changée sur Netlify ne compte qu'au déploiement suivant (les NEXT_PUBLIC_… sont figées à la compilation).
# Le contexte lui-même (CONTEXT) est posé par Netlify, rien à définir : hors production, les images vont dans le magasin
# Netlify Blobs « uploads-preview » et le site n'est pas indexé (src/lib/deploy-context.ts).

# Base PostgreSQL.
# - En local : la base Homebrew (PostgreSQL 17), les deux adresses sont égales.
# - Sur Netlify : copiées depuis la console Neon (base créée dans la région des fonctions Netlify), celles de la branche
#   Neon principale pour « Production », celles de la branche Neon `preview` pour les aperçus.
#   DATABASE_URL : adresse regroupée (avec « connection pooling », hôte en -pooler), qui sert à l'application, suivie de
#   &pgbouncer=true&connect_timeout=15 (Prisma 6 derrière PgBouncer ; réveil de la base gratuite).
#   DATABASE_URL_UNPOOLED : adresse directe, qui sert aux migrations, appliquées à chaque compilation Netlify
#   (`prisma migrate deploy`, voir netlify.toml), suivie de &connect_timeout=15.
#   Exemples fictifs pour Neon (Prisma 6), à saisir sur Netlify (et dans .env.secrets.local pour init-production.mjs),
#   jamais dans .env, .env.local, .env.production ni .env.production.local :
#   DATABASE_URL="postgresql://USER:PASSWORD@ep-exemple-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
#   DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-exemple.region.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
DATABASE_URL="postgresql://mac@localhost:5432/alarobia"
DATABASE_URL_UNPOOLED="postgresql://mac@localhost:5432/alarobia"

# À générer : openssl rand -base64 32. Signe le cookie de session. 32 caractères au moins, sinon la connexion et
# l'inscription échouent avec une erreur qui nomme AUTH_SECRET. Une valeur différente en local, en production et pour
# les aperçus.
AUTH_SECRET=""

# À générer : openssl rand -base64 32. Protège la route du nettoyage quotidien (/api/cron/nettoyage), qui répond 503
# sans elle (facultative en local). En production : la même valeur sur Netlify et dans les secrets du dépôt GitHub,
# avec SITE_URL (adresse du site), pour .github/workflows/nettoyage.yml. Pour les aperçus : une valeur à part.
CRON_SECRET=""

# Adresse publique du site, sans barre finale : adresses canoniques, plan du site, robots.txt, images de partage.
# Sur Netlify, pour le contexte « Production » seulement : l'adresse .netlify.app du site, puis le domaine quand il sera
# branché. Laissée vide, le site prend, hors production, l'adresse du déploiement (DEPLOY_PRIME_URL, figée à la
# compilation : https://preview--alarobia-shop.netlify.app pour la branche preview), puis URL, l'adresse principale que
# Netlify fournit lui-même (celle de la production, même dans un aperçu), puis http://localhost:3000. Rien à régler
# pour les aperçus : une valeur définie pour tous les contextes leur donnerait l'adresse de la production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Facultative. Dossier des fichiers envoyés en local, uploads par défaut. Sur Netlify, les envois vont dans Netlify Blobs
# (magasin « uploads » en production, « uploads-preview » ailleurs) et cette variable ne sert pas.
# UPLOAD_DIR="uploads"

# Données de départ de la production (prisma/init-production.mjs, une seule fois, à la main) : ADMIN_EMAIL et
# ADMIN_PASSWORD (12 caractères au moins) ne vont que dans .env.secrets.local, ignoré par git et que Next ne charge pas,
# avec DATABASE_URL_UNPOOLED, l'adresse directe de Neon, que le script prend en priorité. Ni ici, ni dans .env, ni sur
# Netlify. Jamais d'adresse de la base de production dans .env, .env.local, .env.production ni .env.production.local :
# Next les charge à chaque compilation, et une compilation locale écrirait dans la base réelle.
