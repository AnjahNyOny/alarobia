# Variables du site. En local : copier ce fichier en .env et renseigner AUTH_SECRET.
# En production : à définir dans Netlify (configuration du site, variables d'environnement), pour le contexte
# « Production » seulement : aucun aperçu de déploiement ne doit toucher la base réelle. Une variable changée sur
# Netlify ne compte qu'à la mise en ligne suivante (les NEXT_PUBLIC_… sont figées à la compilation).

# Base PostgreSQL.
# - En local : la base Homebrew (PostgreSQL 17), les deux adresses sont égales.
# - En production : copiées depuis la console Neon (base créée dans la région des fonctions Netlify).
#   DATABASE_URL : adresse regroupée (avec « connection pooling », hôte en -pooler), qui sert à l'application.
#   DATABASE_URL_UNPOOLED : adresse directe, qui sert aux migrations, appliquées à chaque compilation Netlify
#   (`prisma migrate deploy`, voir netlify.toml).
DATABASE_URL="postgresql://mac@localhost:5432/alarobia"
DATABASE_URL_UNPOOLED="postgresql://mac@localhost:5432/alarobia"

# À générer : openssl rand -base64 32. Signe le cookie de session. 32 caractères au moins, sinon la connexion et
# l'inscription échouent avec une erreur qui nomme AUTH_SECRET. Une valeur différente en local et en production.
AUTH_SECRET=""

# À générer : openssl rand -base64 32. Protège la route du nettoyage quotidien (/api/cron/nettoyage), qui répond 503
# sans elle (facultative en local). En production : la même valeur sur Netlify et dans les secrets du dépôt GitHub,
# avec SITE_URL (adresse du site), pour .github/workflows/nettoyage.yml.
CRON_SECRET=""

# Adresse publique du site, sans barre finale : adresses canoniques, plan du site, robots.txt, images de partage.
# En production : l'adresse .netlify.app du site, puis le domaine quand il sera branché. Laissée vide, le site prend
# URL, l'adresse principale que Netlify fournit lui-même à la compilation et aux fonctions (rien à définir), puis
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Facultative. Dossier des fichiers envoyés en local, uploads par défaut. Sur Netlify, les envois vont dans Netlify Blobs
# et cette variable ne sert pas.
# UPLOAD_DIR="uploads"

# Données de départ de la production (prisma/init-production.mjs, une seule fois, à la main) : ADMIN_EMAIL et
# ADMIN_PASSWORD (12 caractères au moins) ne vont que dans .env.production.local, ignoré par git, avec DATABASE_URL et
# DATABASE_URL_UNPOOLED égales à l'adresse directe de Neon. Ni ici, ni dans .env, ni sur Netlify.
