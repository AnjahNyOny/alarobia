# Base PostgreSQL. En local : la base Homebrew (PostgreSQL 17), les deux adresses sont égales.
# En production : copiées depuis Neon dans les variables du site Netlify, l'adresse regroupée (pooler) pour
# DATABASE_URL, qui sert à l'application, et l'adresse directe pour DATABASE_URL_UNPOOLED,
# qui sert aux migrations.
DATABASE_URL="postgresql://mac@localhost:5432/alarobia"
DATABASE_URL_UNPOOLED="postgresql://mac@localhost:5432/alarobia"
# openssl rand -base64 32
AUTH_SECRET=""
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
