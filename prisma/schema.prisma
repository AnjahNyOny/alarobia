// Sur Netlify, la compilation tourne sous Ubuntu et les fonctions sous Amazon Linux : sans la cible
// "rhel-openssl-3.0.x", la compilation réussit mais toute page qui lit la base échoue en ligne (moteur introuvable).
// Sources : https://www.prisma.io/docs/orm/v6/prisma-client/deployment/serverless/deploy-to-netlify et
// https://answers.netlify.com/t/new-builds-are-breaking-in-runtime-with-prisma-errors/107755. "native" sert en local.
generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

// PostgreSQL partout : base Homebrew en local et dans les tests, Neon en production.
// `DATABASE_URL` sert à l'application (adresse regroupée chez Neon), `DATABASE_URL_UNPOOLED` aux migrations
// (adresse directe). Le propriétaire les copie depuis Neon dans les variables du site Netlify ; en local, les deux sont égales.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// Les statuts sont des chaînes, pas des enums : les valeurs autorisées vivent dans src/lib/constants.ts.
// Ajouter une valeur ne demande alors aucune migration.

model User {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String
  name         String
  phone        String?
  role         String         @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt    DateTime       @default(now())
  address      Address?
  orders       Order[]
  reviews      Review[]
  wishlist     WishlistItem[]
}

model Address {
  id         String  @id @default(cuid())
  userId     String  @unique
  user       User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  line1      String // adresse ou lot
  line2      String? // repère pour le livreur
  district   String  @default("") // quartier
  postalCode String  @default("") // facultatif à Madagascar
  city       String
  province   String  @default("")
  country    String  @default("Madagascar")
  phone      String // forme nationale : 034 12 345 67
}

model Category {
  id           String                @id @default(cuid())
  name         String
  slug         String                @unique
  description  String                @default("")
  image        String?
  position     Int                   @default(0)
  products     Product[]
  translations CategoryTranslation[]
}

// Les champs de Category et de Product sont la version française de référence.
// Une ligne de traduction par langue supplémentaire ; un champ vide retombe sur le français.
model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  locale      String // en | mg
  name        String   @default("")
  description String   @default("")

  @@unique([categoryId, locale])
}

model Product {
  id                   String               @id @default(cuid())
  name                 String
  slug                 String               @unique
  tagline              String               @default("")
  description          String
  details              String               @default("") // une caractéristique par ligne
  priceCents           Int
  compareAtCents       Int?
  sku                  String               @unique
  stock                Int                  @default(0)
  status               String               @default("ACTIVE") // ACTIVE | DRAFT | ARCHIVED
  featured             Boolean              @default(false)
  categoryId           String
  category             Category             @relation(fields: [categoryId], references: [id])
  images               ProductImage[]
  reviews              Review[]
  wishlistedBy         WishlistItem[]
  orderItems           OrderItem[]
  translations         ProductTranslation[]
  // Personnalisation (phase 4). Un gabarit vide : le produit n'est pas personnalisable.
  // Valeurs autorisées et lecture de ces champs : src/lib/customization.ts.
  customTemplate       String               @default("") // "" | mug | gourde | carnet | tote
  customColors         String               @default("") // clés de couleur séparées par des virgules : blanc,laterite,indigo
  customTextMax        Int                  @default(0) // longueur maximale du texte ; 0 : pas de texte
  customImage          Boolean              @default(false) // le client peut envoyer une image
  customSurchargeCents Int                  @default(0) // ajouté au prix dès qu'il y a un texte ou une image à imprimer
  customizations       Customization[]
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  @@index([categoryId])
  @@index([status])
}

// Ce qu'un client a dessiné sur un produit personnalisable. Créée à l'ajout au panier (le panier n'en garde
// que l'identifiant), figée dans la ligne de commande à l'achat. Les fichiers sont dans le stockage des envois
// (src/lib/storage.ts), sous un nom généré par le serveur (perso-<uuid>.<ext>). Sans commande au bout de sept
// jours, la ligne et ses fichiers sont supprimés par le nettoyage quotidien (src/lib/cleanup.ts).
model Customization {
  id        String    @id @default(cuid())
  productId String
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  color     String // clé de couleur de l'objet
  text      String    @default("")
  font      String    @default("enseigne")
  ink       String    @default("indigo") // couleur du texte
  textSize  Int       @default(50) // tailles et positions : de 0 à 100
  textY     Int       @default(50)
  image     String? // image envoyée par le client
  imageSize Int       @default(60)
  imageX    Int       @default(50)
  imageY    Int       @default(50)
  preview   String? // aperçu de l'objet, montré dans le panier et la commande
  print     String? // fichier d'impression (zone imprimable seule, fond transparent) ; absent pour un simple choix de couleur
  orderedAt DateTime? // première commande contenant cette personnalisation : elle n'est alors plus jamais nettoyée
  createdAt DateTime  @default(now())

  @@index([productId])
  @@index([orderedAt, createdAt])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  locale      String // en | mg
  name        String  @default("")
  tagline     String  @default("")
  description String  @default("")
  details     String  @default("")

  @@unique([productId, locale])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  url       String
  position  Int     @default(0)

  @@index([productId])
}

model Review {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int
  comment   String
  status    String   @default("PUBLISHED") // PUBLISHED | HIDDEN
  createdAt DateTime @default(now())

  @@unique([productId, userId])
}

model WishlistItem {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, productId])
}

model Order {
  id                String      @id @default(cuid())
  number            String      @unique
  userId            String?
  user              User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  email             String
  status            String      @default("PENDING") // PENDING | PAID | SHIPPED | DELIVERED | CANCELLED | REFUNDED
  paymentMethod     String // MVOLA | ORANGE_MONEY | AIRTEL_MONEY | COD
  paymentReference  String? // référence de transaction Mobile Money déclarée par le client
  paymentDeclaredAt DateTime?
  paidAt            DateTime? // paiement confirmé par le vendeur
  // Nom de la zone de livraison au moment de la commande (copie figée : la zone peut changer ou disparaître).
  shippingZone      String
  estimatedDelivery DateTime? // date promise à la commande
  subtotalCents     Int
  discountCents     Int         @default(0)
  shippingCents     Int
  totalCents        Int
  promoCode         String?
  fullName          String
  line1             String
  line2             String?
  district          String      @default("")
  postalCode        String      @default("")
  city              String
  province          String      @default("")
  country           String      @default("Madagascar")
  phone             String
  trackingNumber    String?
  note              String?
  // Langue du client au moment de la commande (fr, en, mg) : celle des e-mails qui suivent.
  locale            String      @default("fr")
  items             OrderItem[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String   @id @default(cuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  name          String
  imageUrl      String? // photo du produit, ou aperçu de l'objet personnalisé
  priceCents    Int // prix unitaire payé, supplément de personnalisation compris
  quantity      Int
  // Copie figée de la personnalisation (JSON : gabarit, couleur, texte, police, encre, image, réglages).
  // Elle ne dépend plus de la table Customization ni du produit, qui peuvent changer ou disparaître.
  customization String?
  printUrl      String? // fichier d'impression à télécharger par le vendeur

  @@index([orderId])
}

model PromoCode {
  id               String    @id @default(cuid())
  code             String    @unique
  type             String // PERCENT | FIXED
  value            Int // pourcentage, ou montant en centimes
  minSubtotalCents Int       @default(0)
  maxUses          Int?
  usedCount        Int       @default(0)
  expiresAt        DateTime?
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
}

model StoreSettings {
  id                         Int    @id @default(1)
  storeName                  String @default("Alarobia")
  contactEmail               String @default("bonjour@alarobia.example")
  currency                   String @default("MGA")
  announcement               String @default("Livraison offerte dès 150 000 Ar d'achat")
  announcementEn             String @default("")
  announcementMg             String @default("")
  freeShippingThresholdCents Int    @default(15000000)
  // Numéros du vendeur pour le Mobile Money. Un opérateur sans numéro n'est pas proposé à la commande.
  mvolaNumber                String @default("")
  orangeMoneyNumber          String @default("")
  airtelMoneyNumber          String @default("")
  mobileMoneyName            String @default("") // titulaire des comptes, affiché au client pour qu'il vérifie avant d'envoyer
}

// Zones de livraison, gérées dans le back-office. Délais en jours ouvrés (pas de livraison le dimanche).
// La première zone active (par position) sert d'exemple sur l'accueil.
model ShippingZone {
  id         String  @id @default(cuid())
  name       String
  nameEn     String  @default("")
  nameMg     String  @default("")
  priceCents Int
  minDays    Int
  maxDays    Int
  position   Int     @default(0)
  active     Boolean @default(true)
}

model NewsletterSubscriber {
  id            String               @id @default(cuid())
  email         String               @unique
  createdAt     DateTime             @default(now())
  // Jeton des liens de confirmation et de désinscription : 32 octets aléatoires en hexadécimal (src/lib/newsletter.ts).
  token         String               @unique
  // Langue de l'inscription : celle des e-mails (confirmation, lettres).
  locale        String               @default("fr")
  // Date du clic sur « Confirmer » ; seules les adresses confirmées reçoivent la lettre.
  confirmedAt   DateTime?
  // Dernier e-mail de confirmation envoyé : un seul par 24 h et par adresse.
  confirmSentAt DateTime?
  deliveries    NewsletterDelivery[]
}

// Lettre d'information rédigée dans le back-office (PLAN.md 7.14), écrite dans une seule langue par le vendeur.
model NewsletterIssue {
  id         String               @id @default(cuid())
  subject    String
  // Texte brut : paragraphes séparés par une ligne vide, adresses http(s) rendues cliquables dans l'e-mail.
  body       String
  createdAt  DateTime             @default(now())
  // Posée quand plus aucun inscrit confirmé n'attend la lettre ; plus rien ne part ensuite.
  sentAt     DateTime?
  deliveries NewsletterDelivery[]
}

// Une lettre à une adresse : la ligne est réservée avant l'envoi (ok faux), puis passée à vrai (src/lib/newsletter-send.ts).
// La clé primaire empêche tout second envoi de la même lettre à la même adresse. Une désinscription supprime l'inscrit,
// donc ses livraisons.
model NewsletterDelivery {
  issueId      String
  subscriberId String
  sentAt       DateTime             @default(now())
  ok           Boolean              @default(false)
  issue        NewsletterIssue      @relation(fields: [issueId], references: [id], onDelete: Cascade)
  subscriber   NewsletterSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  @@id([issueId, subscriberId])
  // Plafond de 300 envois par 24 h glissantes, toutes lettres comprises.
  @@index([sentAt])
}
